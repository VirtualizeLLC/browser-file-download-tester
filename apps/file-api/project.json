{
  "name": "file-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/file-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "options": {
        "webpackConfig": "apps/file-api/webpack.config.js",
        "outputPath": "dist/apps/file-api"
      },
      "configurations": {
        "production": {
          "optimization": true
        },
        "development": {
          "optimization": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "file-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "file-api:build:development"
        },
        "production": {
          "buildTarget": "file-api:build:production"
        }
      }
    }
  }
}
